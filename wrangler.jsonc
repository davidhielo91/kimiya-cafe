{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kimiya-cafe",
  "compatibility_date": "2026-08-25",
  // Sitio estático: no hay Worker de servidor, solo assets prerenderizados que
  // Next.js exporta a ./out. Cloudflare los sirve directo desde el edge.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
