# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# herramientas locales de skills (no forman parte del sitio)
/.claude/skills/
/skills-lock.json

# documentos de negocio (fuente de verdad en Notion; no versionar)
/PRODUCT.md
/CONTENT.md
/SEO.md
/DEPLOYMENT.md
/IMAGE-PROMPTS.md

# fuentes de diseño (mockups/PNG originales); se sirven ya optimizados en /public
/.design-source/
